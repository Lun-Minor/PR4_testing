<Page x:Class="PR4_1_2.SecondPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR4_1_2"
      mc:Ignorable="d" 
      d:DesignHeight="470" d:DesignWidth="800"
      Title="SecondPage" Background="White">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Задача 2" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Center" Margin="5" >
            <Image Source="C:\Users\Lun\Pictures\Screenshots\Снимок экрана 2026-03-03 212944.png" Stretch="Uniform" MaxHeight="90"/>
        </Border>

        <GroupBox Grid.Row="2" Header="Выберите функцию f(x)">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="rbSinh" Content="sh(x)" GroupName="fGroup" Margin="5" IsChecked="True" ToolTip="Гиперболический синус"/>
                <RadioButton x:Name="rbX2"   Content="x²"    GroupName="fGroup" Margin="5" ToolTip="Квадрат x"/>
                <RadioButton x:Name="rbExp"  Content="e^x"   GroupName="fGroup" Margin="5" ToolTip="Экспонента x"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="50">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="x =" Width="80" VerticalAlignment="Center" FontSize="14" ToolTip="Значение x"/>
                <TextBox x:Name="tbX" Width="220" FontSize="14" ToolTip="Введите x"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="b =" Width="80" VerticalAlignment="Center" FontSize="14" ToolTip="Значение b"/>
                <TextBox x:Name="tbB" Width="220" FontSize="14" ToolTip="Введите b"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button Content="Вычислить" Width="160" Height="42" Margin="5" FontSize="15" Click="btnCalculate_Click" ToolTip="Выполнить расчёт"/>
                <Button Content="Очистить" Width="160" Height="42" FontSize="15" Click="btnClear_Click" ToolTip="Очистить поля"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="s =" Width="80" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Результат"/>
                <TextBox x:Name="tbResult" Width="360" FontSize="16" FontWeight="SemiBold" IsReadOnly="True" Background="#EFF6FF" Padding="8" ToolTip="Результат (только чтение)"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button Content="Назад к первой задаче" Width="200" Margin="5" Click="btnBack_Click"/>
                <Button Content="Переход на 3 задачу" Width="200" Click="btnGO3_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>

