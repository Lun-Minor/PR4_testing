<Window x:Class="PR4_1_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR4_1_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <Frame x:Name="MainFrame" 
               NavigationUIVisibility="Hidden"
               Visibility="Collapsed"/>

        <Grid Margin="5" x:Name="mainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Задача 1"
                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

            <Border Grid.Row="1"
                    BorderBrush="Gray" BorderThickness="1" Background="#F9FAFB" Margin="5">
                <Image Source="C:\Users\Lun\Pictures\Screenshots\Снимок экрана 2026-03-03 212929.png" Stretch="Uniform" MaxHeight="120"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="520">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="x =" Width="100" FontSize="14" VerticalAlignment="Center" ToolTip="Значение x (обязательно -1 ≤ x ≤ 1)"/>
                    <TextBox x:Name="tbX" Width="240" FontSize="14" ToolTip="Введите число x"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="y =" Width="100" FontSize="14" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbY" Width="240" FontSize="14" ToolTip="Введите число y"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="z =" Width="100" FontSize="14" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbZ" Width="240" FontSize="14" ToolTip="Введите число z"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                    <Button x:Name="btnCalculate" Content="Вычислить" Width="160" Height="42" Margin="5" FontSize="15" Click="btnCalculate_Click"/>
                    <Button x:Name="btnClear" Content="Очистить" Width="160" Height="42" FontSize="15" Click="btnClear_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock Text="γ =" Width="100" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbResult" Width="360" FontSize="16" FontWeight="SemiBold"
                             IsReadOnly="True" ToolTip="Результат"/>
                </StackPanel>

                <Button Content="Переход к 2 задаче" Width="180" Margin="5" Click="btn_Go2SecondPage_Click" ToolTip="Перейти ко второй функции"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
