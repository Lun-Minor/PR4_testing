<Page x:Class="PR4_1_2.ThirdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PR4_1_2"
      xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      mc:Ignorable="d"
      d:DesignHeight="520" d:DesignWidth="850"
      Title="ThirdPage" Background="White">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0"
                   Text="Задача 3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

        
        <Border Grid.Row="1" 
BorderBrush="Gray" BorderThickness="1" Background="#F9FAFB" Margin="5,5,5,102">
            <Image Source="C:\Users\Lun\Pictures\Screenshots\Снимок экрана 2026-03-03 212956.png" Height="30"/>
        </Border>

        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="80">
            <StackPanel Margin="5">
                <TextBlock Text="x от" FontSize="14" HorizontalAlignment="Center" Margin="5"/>
                <TextBox x:Name="tbX1" Width="110" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="x до" FontSize="14" HorizontalAlignment="Center" Margin="5"/>
                <TextBox x:Name="tbX2" Width="110" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Шаг h" FontSize="14" HorizontalAlignment="Center" Margin="5"/>
                <TextBox x:Name="tbH" Width="110" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="b" FontSize="14" HorizontalAlignment="Center" Margin="5"/>
                <TextBox x:Name="tbB" Width="110" FontSize="14"/>
            </StackPanel>
        </StackPanel>

        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <Grid Grid.Column="0" x:Name="chartContainer" Margin="5"/>

            <TextBox Grid.Column="1" x:Name="tbTable" Width="300" FontSize="13" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True" />
        </Grid>

       
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="Вычислить" Width="160" Height="30" Margin="5" FontSize="14" Click="btnBuild_Click"/>
            <Button Content="Очистить" Width="160" Height="30" FontSize="14" Click="btnClear_Click"/>
            <Button Content="Закрыть программу" Width="160" Height="30" FontSize="14" Click="btnClose"/>
        </StackPanel>
    </Grid>
</Page>